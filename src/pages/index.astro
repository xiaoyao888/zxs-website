---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, companyInfo, miniProgramName, highlights, articles, stats, serviceSteps, scenarios, facilities, faqs } from '../data/siteConfig.js';
---
<MainLayout title="朔州星火AI自习室 - 智能座位预约自习空间" description="星火AI自习室提供安静舒适的学习空间，通过微信小程序在线座位预约、考勤打卡与学习时长统计，让考研、考公、学习和办公人群的自习更专注、更高效。">
  <Header />
  <main>
    <section class="hero-slide">
      <img src="/static/banner1.jpg" alt="星火AI自习室" />
      <div class="container">
        <div class="row align-items-center">
          <div class="col-12 col-lg-7 text-light">
            <div class="section-kicker text-white-50 mb-3">AI STUDY ROOM</div>
            <h1 class="hero-title">星火AI自习室</h1>
            <p class="lead mt-3 mb-4">{companyInfo.tagline}，星火点亮学习，AI 助力专注，让每一次自习都更高效。</p>
            <div class="d-flex flex-column flex-sm-row gap-3">
              <a class="btn btn-danger btn-lg mr-sm-3 mb-3 mb-sm-0" href="/download.html">在线预约</a>
              <a class="btn btn-outline-light btn-lg" href={`tel:${companyInfo.phone}`}>电话咨询</a>
            </div>
          </div>
          <div class="col-12 col-lg-4 offset-lg-1">
            <div class="hero-card text-center">
              <img src="/static/gh_1b89df639bf6_430.jpg" class="img-fluid mb-3" style="max-width: 180px; border-radius: 50%;" alt="星火AI自习空间小程序码" />
              <h2 class="h4 font-weight-bold">扫码进入小程序</h2>
              <p class="text-secondary mb-0">微信扫一扫，在线选座、考勤打卡、时长统计。</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-4 bg-white border-bottom">
      <div class="container">
        <div class="row text-center">
          {stats.map((item) => (
            <div class="col-6 col-lg-3 py-3">
              <div class="h3 font-weight-bold text-info mb-1">{item.value}</div>
              <div class="small text-secondary">{item.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-light py-5">
      <div class="container">
        <div class="text-center mb-5">
          <div class="section-kicker">ABOUT</div>
          <h2 class="section-title">关于我们</h2>
          <p class="text-secondary">专注智能座位预约自习空间</p>
        </div>
        <div class="row align-items-center">
          <div class="col-12 col-lg-7 text-secondary lh-2" style="text-indent: 2em;">
            星火AI自习室是一款专注智能自习空间预约的服务，旨在为考研、考公、学习和办公人群提供安静舒适、便捷高效的学习环境。用户通过微信小程序在线选座、考勤打卡、查看学习时长，解决传统自习室临时占座、信息不透明、体验不稳定的问题。
          </div>
          <div class="col-12 col-lg-5 mt-4 mt-lg-0">
            <div class="feature-card bg-white">
              <h3 class="h5 font-weight-bold">我们解决的问题</h3>
              <p class="text-secondary mb-2">不用临时找座、反复确认空位、手工登记考勤。</p>
              <p class="text-secondary mb-0">把选座、预约和打卡放到线上，让用户预约更快，让运营管理更清楚。</p>
            </div>
          </div>
        </div>
        <div class="text-center mt-4"><a href="/aboutus.html" class="btn btn-outline-info">查看更多</a></div>
      </div>
    </section>

    <section class="py-5 bg-white">
      <div class="container">
        <div class="text-center mb-5">
          <div class="section-kicker">FEATURES</div>
          <h2 class="section-title">核心能力</h2>
          <p class="text-secondary">围绕用户自习和运营管理的关键环节建设</p>
        </div>
        <div class="row">
          {highlights.map((item) => (
            <div class="col-12 col-md-6 col-lg-4 mb-4">
              <article class="feature-card">
                <h3 class="h5 font-weight-bold text-info">{item.title}</h3>
                <p class="text-secondary mb-0">{item.description}</p>
              </article>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-light py-5">
      <div class="container">
        <div class="text-center mb-5">
          <div class="section-kicker">PROCESS</div>
          <h2 class="section-title">预约流程</h2>
          <p class="text-secondary">从打开小程序到到店学习，流程清晰可追踪</p>
        </div>
        <div class="row">
          {serviceSteps.map((step, index) => (
            <div class="col-12 col-md-6 col-lg-3 mb-4">
              <div class="feature-card h-100">
                <div class="display-4 font-weight-bold text-info">0{index + 1}</div>
                <h3 class="h5 font-weight-bold">{step.title}</h3>
                <p class="text-secondary mb-0">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-5 bg-white">
      <div class="container">
        <div class="row align-items-start">
          <div class="col-12 col-lg-5 mb-4 mb-lg-0">
            <div class="section-kicker">SCENES</div>
            <h2 class="section-title">适用场景</h2>
            <p class="text-secondary lh-2">自习是高频、长期、需要专注的本地服务。星火AI自习室把座位、时段和考勤记录沉淀下来，减少每次预约和找座的沟通成本。</p>
          </div>
          <div class="col-12 col-lg-7">
            {scenarios.map((item) => (
              <div class="feature-card mb-3">
                <h3 class="h5 font-weight-bold text-info">{item.title}</h3>
                <p class="text-secondary mb-0">{item.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-light py-5">
      <div class="container">
        <div class="text-center mb-4">
          <div class="section-kicker">FACILITIES</div>
          <h2 class="section-title">自习室设施与服务</h2>
          <p class="text-secondary">舒适的学习环境，细节保障专注</p>
        </div>
        <div class="d-flex flex-wrap justify-content-center">
          {facilities.map((item) => <span class="badge badge-pill badge-info p-3 m-2">{item}</span>)}
        </div>
      </div>
    </section>

    <section class="py-5 bg-white">
      <div class="container">
        <div class="text-center mb-5">
          <div class="section-kicker">FAQ</div>
          <h2 class="section-title">常见问题</h2>
        </div>
        <div class="row">
          {faqs.map((faq) => (
            <div class="col-12 mb-3">
              <div class="faq-card">
                <div class="faq-q">
                  <span class="faq-badge q">问</span>
                  <h3>{faq.question}</h3>
                </div>
                <div class="faq-a">
                  <span class="faq-badge a">答</span>
                  <p>{faq.answer}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-light py-5">
      <div class="container">
        <div class="text-center mb-5">
          <div class="section-kicker">NEWS</div>
          <h2 class="section-title">新闻中心</h2>
          <p class="text-secondary">了解公司动态及行业资讯</p>
        </div>
        <div class="row">
          {articles.map((news) => (
            <div class="col-12 col-lg-6 mb-3">
              <a class="news-link" href={`/${news.section}/${news.id}.html`}>
                <h3 class="h5 font-weight-bold">{news.title}{news.isTop && <span class="badge badge-danger ml-2">置顶</span>}</h3>
                <p class="text-secondary mb-1">{news.summary}</p>
                <time class="small text-muted">{news.date}</time>
              </a>
            </div>
          ))}
        </div>
        <div class="text-center mt-3"><a href="/article.html" class="btn btn-warning text-white">查看全部</a></div>
      </div>
    </section>
  </main>
  <Footer />
</MainLayout>
