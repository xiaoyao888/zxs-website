---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { site, articles } from '../data/siteConfig.js';
---
<MainLayout title={`自习室资讯 - ${site.title}`} description="星火AI自习空间发布自习室座位预约、考研考公备考、智能自习空间和学习服务相关资讯。">
  <Header />
  <PageHero title="新闻中心" subtitle="了解最新公司动态及行业资讯" image="/static/banner1.jpg" />
  <main class="container pages">
    <div class="text-left position mb-3 d-none d-md-block">当前位置：<a href="/">首页</a> &gt; <a href="/article.html">新闻中心</a></div>
    <div class="sonsort mt-4 mb-2">
      <a href="/article.html" class="btn btn-info mb-2">全部 <span class="badge badge-light">{articles.length}</span></a>
      <a href="/article.html#company" class="btn btn-light mb-2">公司动态 <span class="badge btn-info">{articles.filter((item) => item.section === 'company').length}</span></a>
      <a href="/article.html#industry" class="btn btn-light mb-2">行业动态 <span class="badge btn-info">{articles.filter((item) => item.section === 'industry').length}</span></a>
    </div>
    <ul class="list-unstyled">
      {articles.map((news) => (
        <li class="lh-3 border-bottom-dashed" id={news.section}>
          <i class="fa fa-gg text-info mr-2"></i>
          <a href={`/${news.section}/${news.id}.html`}>
            <span>{news.title}</span>
            {news.isTop && <span class="badge badge-danger ml-2">置顶</span>}
            <span class="float-right d-none d-sm-inline">{news.date}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
  <Footer />
</MainLayout>
